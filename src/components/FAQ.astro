---
interface Props { items: {question: string; answer: string}[] }
const { items } = Astro.props;
---
<div class="faq-list">{items.map(item => <details class="faq-item"><summary>{item.question}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{item.answer}</p></div></details>)}</div>
