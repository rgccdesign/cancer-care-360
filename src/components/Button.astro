---
import Icon from './Icon.astro';
interface Props { href: string; label: string; external?: boolean; class?: string }
const { href, label, external = false, class: className = '' } = Astro.props;
---
<a class:list={['button', className]} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{label}<Icon name={external ? 'external' : 'arrow'} size={24} /></a>
