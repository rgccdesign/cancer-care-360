---
import {pageVisuals,guideVisuals} from '../config/page-visuals';
interface Props { eyebrow?: string; title: string; description?: string; image?: string }
const { eyebrow, title, description, image } = Astro.props;
const slug=Astro.url.pathname.split('/').filter(Boolean).at(-1) || '';
const visual=guideVisuals[slug] || pageVisuals[Astro.url.pathname] || image || '/images/education/documents.svg';
---
<section class="page-intro has-image unified-intro"><div class="container page-intro-inner"><div class="intro-copy">{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h1>{title}</h1>{description && <p class="intro-description">{description}</p>}<slot/></div><div class="intro-visual"><img src={visual} alt="" width="600" height="420" fetchpriority="high"/></div></div><svg class="intro-wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M930 60C1120 55 1230 18 1440 5v55Z" fill="#b1e8e9"/><path d="M0 57C400 31 790 72 1080 51s260-36 360-23v32H0Z" fill="white"/></svg></section>
