---
import { site, navigation } from '../config/site';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top"><a href="/" class="brand"><img src={site.logo} alt="Cancer Care 360 home" width={site.logoWidth} height={site.logoHeight} loading="lazy" /></a><nav aria-label="Footer navigation">{navigation.slice(1).map(item => <a href={item.href}>{item.label}</a>)}<a href="/contact/">Contact</a><a class="footer-social" href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook <Icon name="external" size={12}/><span class="sr-only">(opens in a new tab)</span></a></nav></div>
    <p class="footer-disclaimer">This website provides general cancer information and educational resources. It does not replace professional medical advice, diagnosis or treatment.</p>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} Cancer Care 360</span><nav aria-label="Legal"><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-of-use/">Terms of Use</a><a href="/medical-disclaimer/">Medical Disclaimer</a></nav></div>
  </div>
</footer>
