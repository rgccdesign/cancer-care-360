---
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import ResourceCategories from '../../components/ResourceCategories.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import Icon from '../../components/Icon.astro';
import PageIntro from '../../components/PageIntro.astro';
import FAQ from '../../components/FAQ.astro';
import { educationalVideos, resources, resourceTypes } from '../../content/resources';
const faqs = [
  { question: 'How do I find out whether an access programme is suitable?', answer: 'Start with your treating team, hospital pharmacist or social worker. Ask who runs the programme, which eligibility criteria apply, what costs remain and how your information will be used. Availability varies by location and may change.' },
  { question: 'Does Cancer Care 360 provide treatment or approve programme applications?', answer: 'This website provides general education. It does not diagnose, prescribe, determine programme eligibility or guarantee access. Clinical decisions belong with your treating team; programme decisions belong with the programme provider.' },
  { question: 'Can I send my medical records through social media?', answer: 'Please do not send medical records, identity documents or detailed diagnoses through public comments or unsecured messages. Ask your healthcare provider about an appropriate secure route if documents are needed.' },
  { question: 'Can another patient’s experience tell me what will happen?', answer: 'No. A person’s story is one individual experience, not evidence that a treatment will have the same effect for someone else. Outcomes depend on many factors. Discuss treatment questions with your care team.' },
];
---
<MainLayout title="Patient Resources" description="Find cancer education videos, patient access programme information, webinars and practical questions to discuss with your care team." breadcrumbs={[{ label: 'Patient Resources' }]}>
  <PageIntro eyebrow="Patient resources" title="Information, Education and Support for Your Cancer Journey." description="A little clarity, a useful question, a place to start. Explore resources at your own pace." image="/images/cards/support.webp" />
  <div class="container"><ResourceCategories/>
    <section class="section access-section" id="access-programmes" aria-labelledby="access-title"><div><p class="eyebrow">Exploring support</p><h2 id="access-title">Patient access programmes</h2><p>Eligible patients may be able to explore sponsored medicines, financial assistance, diagnostic support or managed access, depending on the programme.</p><p>Criteria, location, clinical requirements, funding and availability vary. A programme may cover only certain costs and does not guarantee a particular treatment or outcome.</p><WhatsAppCTA label="Ask a General Question"/></div><aside class="info-card"><h3>Before you apply, ask:</h3><ul class="check-list"><li>Who operates and funds the programme?</li><li>What are the eligibility and referral requirements?</li><li>Which costs are covered, and for how long?</li><li>How are personal and medical information protected?</li></ul><p class="muted">Your care team or hospital social worker can help you understand local options.</p></aside></section>
    <section class="section library" id="resource-library" aria-labelledby="library-title"><div class="library-intro"><div><p class="eyebrow">Find what helps you</p><h2 id="library-title">Your resource library</h2><p class="section-intro">Explore trusted educational sources and our patient experience collection. External resources are managed by their own providers.</p>
      <nav class="resource-filters" aria-label="Filter resources"><a href="/patient-resources/#resource-library" data-filter="all" aria-current="true">All resources</a>{resourceTypes.map(type => <a href={`?type=${type.key}#resource-library`} data-filter={type.key}>{type.label}</a>)}</nav>
      </div><div class="library-intro-visual"><img src="/images/hero/consultation.webp" alt="Illustration of a patient and healthcare professional reviewing educational information on a tablet" width="1536" height="1024" loading="lazy"/></div></div><p class="filter-status sr-only" aria-live="polite" aria-atomic="true"></p>
      {resourceTypes.map(type => <section class="resource-group" id={type.key} data-resource-group={type.key} aria-labelledby={`${type.key}-title`}><h3 id={`${type.key}-title`} class="category-title">{type.label}</h3>{type.key === 'stories' && !resources.some(resource => resource.type === 'stories') ? <div class="story-empty"><div><span class="empty-eyebrow">Shared with care</span><h4>Every experience deserves respect.</h4><p>No patient stories have been published here yet. Stories will be shared only with documented consent and editorial approval.</p><p>Personal experiences cannot predict an individual treatment outcome.</p></div><a href="/contact/">Contact the team about sharing a story →</a></div> : <div class="card-grid resource-card-grid">{resources.filter(resource => resource.type === type.key).map(resource => <article class="resource-card"><div class="resource-format">{resource.format}</div><h4>{resource.title}</h4><p>{resource.description}</p><span class="provider">{resource.provider}</span><a href={resource.href} target="_blank" rel="noopener noreferrer" aria-label={`Explore resource: ${resource.title} (opens in a new tab)`}>Explore resource <Icon name="external" size={15}/></a></article>)}{type.key === 'videos' && educationalVideos.map(video => <article class="resource-card"><div class="resource-format">Educational video</div><h4>{video.title}</h4><p>{video.description}</p><span class="provider">{video.provider}</span><a href={video.youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label={`Watch on YouTube: ${video.title} (opens in a new tab)`}>Watch on YouTube <Icon name="external" size={15}/></a></article>)}</div>}{type.key === 'webinars' && <p class="library-note">No Cancer Care 360 webinar dates are currently listed. The collection above links to an external provider’s education programmes.</p>}</section>)}
    </section>
    <section class="section" id="faqs" aria-labelledby="faq-title"><p class="eyebrow">Practical questions</p><h2 id="faq-title">Finding your next step.</h2><FAQ items={faqs} /></section>
    <section class="content-section references" aria-labelledby="sources-title"><h2 id="sources-title">Sources & further support</h2><ul class="source-list"><li><a href="https://www.cancer.gov/about-cancer/managing-care" target="_blank" rel="noopener noreferrer">National Cancer Institute: Managing cancer care</a></li><li><a href="https://www.cancer.gov/about-cancer/treatment/questions" target="_blank" rel="noopener noreferrer">National Cancer Institute: Questions to ask about treatment</a></li></ul><p class="note">Educational draft: clinical review and local programme verification are required before publication. Resources support a conversation with your healthcare team and do not replace medical advice.</p></section>
  </div>
</MainLayout>
<script>
  const filters = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-filter]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-resource-group]'));
  const status = document.querySelector<HTMLElement>('.filter-status');
  const validTypes = new Set(['videos', 'stories', 'webinars', 'insights']);
  function setFilter(value: string, announce = false) {
    const selected = validTypes.has(value) ? value : 'all';
    groups.forEach(group => { group.hidden = selected !== 'all' && group.dataset.resourceGroup !== selected; });
    filters.forEach(filter => {
      if (filter.dataset.filter === selected) filter.setAttribute('aria-current', 'true');
      else filter.removeAttribute('aria-current');
    });
    if (announce && status) {
      const label = filters.find(filter => filter.dataset.filter === selected)?.textContent ?? 'All resources';
      status.textContent = `Showing ${label.toLowerCase()}.`;
    }
  }
  setFilter(new URLSearchParams(location.search).get('type') ?? 'all');
  filters.forEach(filter => filter.addEventListener('click', event => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    const value = filter.dataset.filter ?? 'all';
    const url = new URL(location.href);
    if (value === 'all') url.searchParams.delete('type');
    else url.searchParams.set('type', value);
    url.hash = 'resource-library';
    history.pushState({}, '', url);
    setFilter(value, true);
  }));
  window.addEventListener('popstate', () => setFilter(new URLSearchParams(location.search).get('type') ?? 'all', true));
</script>
<style>
.access-section{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}.access-section>div>p{max-width:60ch}.check-list{padding-left:20px}.check-list li{padding:8px 0}.section-intro{max-width:70ch;color:#526375}.resource-filters{display:flex;flex-wrap:wrap;gap:10px;margin:30px 0}.resource-filters a{padding:11px 18px;background:#f2f9fc;border:1px solid #dbe8ee;border-radius:30px;text-decoration:none;font-size:.88rem;font-weight:650}.resource-filters a[aria-current=true]{background:#007e87;color:white;border-color:#006a72}.resource-group{margin:34px 0 40px;scroll-margin-top:120px}.resource-group[hidden]{display:none}.category-title{font-size:1.4rem;margin:0 0 20px}.resource-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.resource-card{padding:28px;border:1px solid #dbe8ee;border-radius:22px;display:flex;flex-direction:column;align-items:flex-start;background:white}.resource-format,.empty-eyebrow{font-size:.75rem;color:#006a72;text-transform:uppercase;letter-spacing:.08em;font-weight:700}.resource-card h4{font-size:1.35rem;margin:14px 0 12px;line-height:1.25}.resource-card p{margin:0 0 20px;color:#526375}.provider{font-size:.8rem;color:#526375;margin-top:auto;margin-bottom:12px}.resource-card a{display:inline-flex;align-items:center;gap:8px;font-weight:650;text-underline-offset:4px}.resource-card a span{margin-left:8px}.story-empty{display:flex;justify-content:space-between;align-items:center;gap:45px;background:#f4f1fa;border-radius:24px;padding:32px}.story-empty>div{max-width:600px}.story-empty h4{font-size:1.5rem;margin:12px 0}.story-empty p{color:#526375}.story-empty>a{font-weight:650;max-width:220px;flex-shrink:0}.library-note{font-size:.9rem;color:#526375;margin-top:16px}.references{padding-bottom:50px}.references h2{font-size:1.3rem}@media(max-width:800px){.access-section{gap:28px}.story-empty{gap:24px;align-items:flex-start;flex-direction:column}.story-empty>a{max-width:none}}@media(max-width:650px){.access-section,.resource-card-grid{grid-template-columns:1fr}.resource-card,.story-empty{padding:24px}.resource-filters{gap:8px}.resource-filters a{padding:10px 14px;font-size:.8rem}}
</style>
