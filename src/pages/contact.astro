---
import MainLayout from '../layouts/MainLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
---
<MainLayout title="Contact Us" description="Connect with Cancer Care 360 for general cancer education and resource enquiries." breadcrumbs={[{label:'Contact'}]}>
  <PageIntro eyebrow="Here to help you find your next step" title="Have Questions? Let's Connect." description="Whether you’re a patient, a family member or a healthcare professional, start a conversation with Cancer Care 360." />
  <section class="container section"><div class="contact-grid"><div><h2>Connect with our community</h2><p>Find our updates and contact us through the official Cancer Care 360 Facebook page.</p><a class="contact-channel" href={site.facebook} target="_blank" rel="noopener noreferrer"><span class="channel-icon" aria-hidden="true">f</span><span><strong>Facebook</strong><span>Visit Cancer Care 360’s official page ↗</span></span><Icon name="external"/></a>{site.whatsapp && <a class="contact-channel" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer"><Icon name="chat" size={35}/><span><strong>WhatsApp</strong><span>Send a general enquiry ↗</span></span></a>}{site.email && <a class="contact-channel" href={`mailto:${site.email}`}><Icon name="mail" size={35}/><span><strong>Email</strong><span>{site.email}</span></span></a>}{!site.email && !site.whatsapp && <p class="channel-note">Our Facebook page is the contact channel currently listed here.</p>}</div><aside class="contact-guidance"><Icon name="shield" size={40}/><h2>A little guidance before you connect</h2><p>Please keep enquiries general. Do not send medical records, test results, identity documents or detailed diagnoses through social media or email.</p><p>For personal medical advice, contact your treating team. If you need urgent care, use your local emergency services.</p><a href="/patient-resources/">Explore patient resources →</a></aside></div></section>
</MainLayout>
<style>.contact-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:65px;align-items:start}.contact-grid h2{font-size:1.6rem}.contact-grid p{max-width:530px}.contact-channel{display:flex;gap:20px;align-items:center;border:1px solid var(--border);padding:23px 25px;border-radius:17px;margin-top:22px;text-decoration:none;transition:background .2s}.contact-channel:hover{background:var(--pale)}.contact-channel>svg:last-child{margin-left:auto;color:var(--teal)}.contact-channel strong{display:block;margin-bottom:5px}.contact-channel span span{font-size:.85rem;color:var(--text)}.channel-icon{display:grid;place-items:center;background:#081c54;border-radius:10px;color:#fff;font-family:Arial,sans-serif;font-size:2.2rem;font-weight:bold;width:45px;height:45px;flex-shrink:0}.channel-note{font-size:.85rem;margin-top:20px}.contact-guidance{background:var(--pale);border-radius:23px;padding:35px}.contact-guidance>svg{color:var(--teal);margin-bottom:20px}.contact-guidance h2{font-size:1.4rem}.contact-guidance p{font-size:.95rem}.contact-guidance a{color:#006d80;font-size:.95rem;font-weight:600}@media(max-width:820px){.contact-grid{gap:30px}}@media(max-width:640px){.contact-grid{grid-template-columns:1fr}.contact-guidance{padding:27px}.contact-channel{padding:21px 18px;gap:15px}.contact-channel>svg:last-child{width:18px}.contact-channel span span{font-size:.76rem}}</style>
