---
import MainLayout from '../../layouts/MainLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContentCard from '../../components/ContentCard.astro';
import Button from '../../components/Button.astro';
const audiences = ['Oncologists', 'Physicians', 'Clinical practitioners', 'Diagnostic laboratories', 'Healthcare organisations'];
---
<MainLayout title="Healthcare Professionals" description="Explore cancer education, precision medicine information, patient access programme awareness and opportunities for professional collaboration." breadcrumbs={[{ label: 'Healthcare Professionals' }]}>
  <PageIntro eyebrow="For healthcare professionals" title="Supporting Better-Informed Cancer Care." description="Clear educational resources to support conversations between healthcare professionals, patients and the people who care for them." image="/images/resources/doctor.webp" />
  <div class="container">
    <section class="section audience-section" aria-labelledby="audience-title"><div><p class="eyebrow">A shared understanding</p><h2 id="audience-title">Information that supports a conversation.</h2><p>Cancer Care 360 brings together accessible cancer education and explanations of evolving diagnostic approaches. Resources are intended to complement clinical judgement, current guidance and local care pathways.</p></div><aside class="info-card"><h3>For the people involved in care</h3><ul class="audience-list">{audiences.map(audience => <li>{audience}</li>)}</ul></aside></section>
    <section class="section" aria-labelledby="professional-resources-title"><p class="eyebrow">Explore the resources</p><h2 id="professional-resources-title">Useful information, clearly presented.</h2><div class="card-grid professional-grid"><ContentCard title="Cancer Education Resources" description="Plain-language guides to cancer biology, diagnosis, staging and treatment for patient conversations." href="/learn-about-cancer/" /><ContentCard title="Precision Medicine Information" description="An introduction to biomarker testing, liquid biopsy, CTCs, ctDNA and the limitations of individual tests." href="/precision-medicine/" /><ContentCard title="Patient Access Programme Awareness" description="Questions to help patients and teams explore eligibility, scope, costs and local programme requirements." href="/patient-resources/#access-programmes" /><ContentCard title="Expert & Educational Resources" description="Selected institutional information to support further reading and informed questions." href="/patient-resources/?type=insights#resource-library" /></div></section>
    <section class="section collaboration" aria-labelledby="collaboration-title"><div><p class="eyebrow">Opportunities to contribute</p><h2 id="collaboration-title">Better information starts with dialogue.</h2><p>We welcome enquiries about reviewing educational content, contributing appropriately sourced resources or discussing potential education initiatives.</p><p>Any proposed collaboration needs a separate discussion of scope, responsibilities, evidence and applicable requirements.</p><Button href="/contact/" label="Connect With Cancer Care 360" /></div><div class="collaboration-topics"><h3>Start a conversation about</h3><ul><li>Clinical review of patient education</li><li>Accessible explanations of testing</li><li>Patient support information</li><li>Professional education topics</li></ul></div></section>
    <aside class="note">Content is educational. Cancer Care 360 does not confer accreditation, establish an approved medical partnership or guarantee programme access. Patient care remains the responsibility of the treating team.</aside>
    <section class="content-section references" aria-labelledby="sources-title"><h2 id="sources-title">Professional reference points</h2><ul class="source-list"><li><a href="https://www.cancer.gov/about-cancer/treatment/types/biomarker-testing-cancer-treatment" target="_blank" rel="noopener noreferrer">National Cancer Institute: Biomarker testing for cancer treatment</a></li><li><a href="https://www.esmo.org/guidelines" target="_blank" rel="noopener noreferrer">European Society for Medical Oncology: Clinical practice guidelines</a></li><li><a href="https://www.cancer.gov/about-cancer/treatment/clinical-trials" target="_blank" rel="noopener noreferrer">National Cancer Institute: Clinical trial information</a></li></ul><p class="note">Educational draft: clinical review is required before publication. Follow current local guidance and evaluate the evidence for each clinical application.</p></section>
  </div>
</MainLayout>
<style>
.audience-section{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:start}.audience-section>div>p{max-width:60ch}.audience-list{padding:0;margin:20px 0 0;list-style:none;display:flex;flex-wrap:wrap;gap:10px}.audience-list li{background:#edf7f8;color:#096b76;border-radius:30px;padding:9px 15px;font-size:.88rem}.professional-grid{grid-template-columns:repeat(2,minmax(0,1fr));margin-top:28px}.collaboration{display:grid;grid-template-columns:1.2fr 1fr;gap:64px;align-items:center;background:#f2f9fc;border-radius:26px;padding:40px;margin-bottom:32px}.collaboration-topics{padding-left:34px;border-left:1px solid #cce2e8}.collaboration-topics h3{font-size:1.3rem}.collaboration-topics ul{padding-left:20px}.collaboration-topics li{padding:8px 0}.references{margin-top:38px;padding-bottom:50px}.references h2{font-size:1.3rem}@media(max-width:800px){.audience-section,.collaboration{gap:30px}}@media(max-width:650px){.audience-section,.collaboration,.professional-grid{grid-template-columns:1fr}.collaboration{padding:26px}.collaboration-topics{padding-left:0;border-left:0;border-top:1px solid #cce2e8;padding-top:18px}}
</style>
