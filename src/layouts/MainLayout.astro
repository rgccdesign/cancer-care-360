---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '../styles/global.css';
import '../styles/surfaces.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, isProductionUrl } from '../config/site';
interface Props { title: string; description?: string; breadcrumbs?: {label: string; href?: string}[] }
const {title, description = site.description, breadcrumbs} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title === 'Home' ? 'Cancer Care 360 | Understand Cancer. Explore Your Options.' : `${title} | Cancer Care 360`;
---
<!doctype html>
<html lang="en-GB"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#081c54"/><title>{fullTitle}</title><meta name="description" content={description}/><meta name="robots" content={isProductionUrl ? 'index, follow' : 'noindex, nofollow'}/><link rel="canonical" href={canonical}/>{site.officialLogoConfigured ? <>{[16,32,48].map(size => <link rel="icon" type="image/png" sizes={`${size}x${size}`} href={`/images/brand/icon-${size}.png`}/>)}<link rel="apple-touch-icon" sizes="180x180" href="/images/brand/icon-180.png"/></> : <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>}<meta property="og:type" content="website"/><meta property="og:locale" content="en_GB"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/hero/consultation.webp', site.url).href}/><meta name="twitter:card" content="summary_large_image"/><link rel="sitemap" href="/sitemap.xml"/></head><body class:list={[{"official-branding": site.officialLogoConfigured}]}><a class="skip-link" href="#main">Skip to content</a><Header/><main id="main">{breadcrumbs && <nav class="breadcrumbs container" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li>{breadcrumbs.map((crumb, index) => <li>{crumb.href && index < breadcrumbs.length - 1 ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>)}</ol></nav>}<slot/></main><Footer/></body></html>
